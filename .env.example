# Copiază fișierul ca `.env` și completează valorile. Aceleași variabile
# trebuie puse și în Vercel → Settings → Environment Variables.

# Baza de date Prisma Postgres
DATABASE_URL=

# NextAuth. AUTH_SECRET se generează cu: npx auth secret
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Resend — trimiterea emailurilor de confirmare a contului.
# Cheia se ia din https://resend.com/api-keys (începe cu „re_”).
# Fără ea aplicația pornește, dar linkul de confirmare este doar scris în
# consola serverului, în loc să fie trimis pe email.
RESEND_API_KEY=
# Expeditorul. Cu „onboarding@resend.dev” Resend livrează doar către adresa
# contului tău; pentru clienți reali verifică-ți domeniul în Resend și pune
# aici ceva de forma: Scorer <contact@scorer.ro>
EMAIL_FROM="Scorer <onboarding@resend.dev>"

# Doar pentru testare, cât timp expeditorul nu are domeniu verificat în Resend:
# pune-o pe „1” și conturile noi sunt gata de folosit fără confirmare pe email.
# Lasă-o goală pe un site public — altfel oricine poate deschide un cont cu
# adresa altcuiva.
CONFIRMARE_EMAIL_OPTIONALA=

# Stocarea pozelor (bucket S3-compatibil)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=

# Autentificare cu Google / Apple. Fără chei, butoanele nu apar.
# Google (site): https://console.cloud.google.com → Credentials → OAuth client (Web)
#   redirect: <adresa-site>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Apple (site): AUTH_APPLE_SECRET e un JWT generat din cheia .p8 (npx auth add apple)
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
# Aplicația iOS: ID-ul clientului Google de tip iOS și identificatorul aplicației
GOOGLE_IOS_CLIENT_ID=
APPLE_BUNDLE_ID=ro.scorer.app
